{
  "admin/services/ows": {
    "title": "OWS",
    "order": 90,
    "action": { "type": "view", "path": "ows-services" },
    "depends": { "acl": ["luci-app-ows"] }
  },
  "admin/services/ows-native-zapret2": {
    "action": { "type": "view", "path": "ows-native-zapret2" },
    "depends": {
      "acl": ["luci-app-zapret2"],
      "fs": { "/www/luci-static/resources/view/zapret2/loader.js": "file" }
    }
  },
  "admin/services/ows-native-zapret2-settings": {
    "action": { "type": "view", "path": "zapret2/settings" },
    "depends": {
      "acl": ["luci-app-zapret2"],
      "fs": { "/www/luci-static/resources/view/zapret2/settings.js": "file" }
    }
  },
  "admin/services/ows-native-zapret2-service": {
    "action": { "type": "view", "path": "zapret2/service" },
    "depends": {
      "acl": ["luci-app-zapret2"],
      "fs": { "/www/luci-static/resources/view/zapret2/service.js": "file" }
    }
  },
  "admin/services/ows-native-zapret2-dmnlog": {
    "action": { "type": "view", "path": "zapret2/dmnlog" },
    "depends": {
      "acl": ["luci-app-zapret2"],
      "fs": { "/www/luci-static/resources/view/zapret2/dmnlog.js": "file" }
    }
  },
  "admin/services/ows-native-zapret": {
    "action": { "type": "view", "path": "zapret/settings" },
    "depends": {
      "acl": ["luci-app-zapret"],
      "fs": { "/www/luci-static/resources/view/zapret/settings.js": "file" }
    }
  },
  "admin/services/ows-native-netshift": {
    "action": { "type": "view", "path": "ows-native-netshift" },
    "depends": {
      "acl": ["luci-app-netshift"],
      "fs": { "/usr/share/luci/menu.d/luci-app-netshift.json": "file" },
      "uci": { "netshift": true }
    }
  },
  "admin/services/ows-native-adblock-fast": {
    "action": { "type": "view", "path": "adblock-fast/overview" },
    "depends": {
      "acl": ["luci-app-adblock-fast"],
      "fs": { "/www/luci-static/resources/view/adblock-fast/overview.js": "file" },
      "uci": { "adblock-fast": true }
    }
  },
  "admin/services/ows-native-https-dns-proxy": {
    "action": { "type": "view", "path": "https-dns-proxy/overview" },
    "depends": {
      "acl": ["luci-app-https-dns-proxy"],
      "fs": { "/www/luci-static/resources/view/https-dns-proxy/overview.js": "file" }
    }
  }
}
