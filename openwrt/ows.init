#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/ows worker
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance

    procd_open_instance diagnostics
    procd_set_param command /usr/sbin/ows worker --diagnostic
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}
