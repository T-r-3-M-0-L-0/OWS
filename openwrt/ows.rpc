#!/bin/sh
ows_status() {
    . /usr/share/libubox/jshn.sh
    result=$(/usr/sbin/ows status "$@") || exit 1
    json_load "$result" || exit 1
    json_get_var status_job job
    case "$status_job" in
        ''|*[!0-9-]*) ;;
        *)
            job_dir=/tmp/ows/jobs/$status_job
            if [ -f "$job_dir/kind" ]; then
                json_add_string kind "$(cat "$job_dir/kind")"
                if [ -f "$job_dir/action" ]; then
                    json_add_string action "$(cat "$job_dir/action")"
                fi
            fi
            if [ -s "$job_dir/output" ]; then json_add_boolean has_output 1; fi
            ;;
    esac
    json_dump
}

ows_vpn() (
    . /usr/share/libubox/jshn.sh
    json_load "$(cat)" || exit 1
    json_get_vars id action target change
    . /usr/lib/ows/vpn.sh
    . /usr/lib/ows/registry.sh
    if ! service=$(ows_vpn_service "$id") || [ -z "$service" ]; then
        echo '{"error":"VPN-драйвер OWS не подключён"}'
        exit
    fi
    if [ "$(registry_adapter_service "$id")" != "$service" ]; then
        echo '{"error":"VPN-адаптер не подключён"}'
        exit
    fi
    ows_vpn_load "$id" /usr/lib/ows || { echo '{"error":"Файлы VPN-драйвера недоступны"}'; exit; }
    if [ "$1" = vpn_state ]; then
        "${id}_info"
        exit $?
    fi
    case "$1" in
        vpn_editor) handler=${id}_editor_state ;;
        vpn_nodes) handler=${id}_editor_nodes ;;
        vpn_subscription_url) handler=${id}_subscription_url ;;
        vpn_edit)
            if ! "${id}_action_allowed" edit; then
                echo '{"error":"Редактор для этого драйвера недоступен"}'; exit
            fi
            if [ -z "$change" ] || [ "${#change}" -gt 65536 ]; then
                echo '{"error":"Пустой или слишком большой запрос"}'; exit
            fi
            umask 077
            request=$(mktemp /tmp/ows-vpn-edit.XXXXXX) || exit 1
            trap 'rm -f "$request"' EXIT
            printf '%s\n' "$change" > "$request" || exit 1
            json_init
            if job=$(/usr/sbin/ows "$id" edit "$request"); then json_add_string job "$job"
            else json_add_string error 'Не удалось поставить изменение в очередь'; fi
            json_dump
            exit
            ;;
    esac
    if [ -n "${handler:-}" ]; then
        if command -v "$handler" >/dev/null; then "$handler" "$target"
        else echo '{"error":"Операция недоступна для этого драйвера"}'; fi
        exit $?
    fi
    case "$action" in
        diagnose) command=diag ;;
        inspect_subscription) command=check:$target ;;
        prepare_migration) command=prepare-migration ;;
        probe_node) command=probe:$target ;;
        probe_all_nodes) command=probe-all:$target ;;
        preview_service_lists) command=list-preview:$target ;;
        refresh_draft_subscription) command=refresh-draft-subscription ;;
        check_handover) command=check-handover ;;
        test_draft_lists) command=test-draft-lists ;;
        takeover) command=takeover ;;
        refresh_live_lists) command=refresh-live-lists ;;
        refresh_live_subscription) command=refresh-live-subscription ;;
        preview_draft) command=preview-draft:$target ;;
        apply_draft) command=apply-draft:$target ;;
        *) command='' ;;
    esac
    json_init
    if [ -n "$command" ] && "${id}_action_allowed" "$command" && job=$(/usr/sbin/ows "$id" "$command"); then
        json_add_string job "$job"
    else
        json_add_string error 'Действие VPN недоступно'
    fi
    json_dump
)

ows_guides() (
    . /usr/share/libubox/jshn.sh
    . /usr/lib/ows/instructions.sh
    if [ "$1" = instructions_list ]; then guide_list; exit $?; fi
    request=$(head -c 120001) || exit 1
    if [ "${#request}" -gt 120000 ] || ! json_load "$request"; then
        guide_error 'Некорректный или слишком большой запрос.'; exit 0
    fi
    json_get_var id id
    if [ "$1" = instructions_read ]; then
        guide_read "$id" || exit 0
    else
        json_get_vars operation expected content
        guide_edit "$operation" "$id" "$expected" "$content" || exit 0
    fi
)

case "$1:$2" in
    list:) echo '{"instructions_list":{},"instructions_read":{"id":""},"instructions_write":{"operation":"","id":"","expected":"","content":""},"status":{},"job_status":{"job":""},"services_status":{},"job_output":{"job":""},"catalog":{},"preview":{"profile":"","line":"","action":"","blob":"","expected":""},"apply_action":{"profile":"","line":"","action":"","blob":"","expected":""},"module_list":{},"module_status":{"id":""},"module_preview":{"manifest":""},"module_attach":{"manifest":""},"module_link":{"name":"","source":""},"stgws_info":{},"stgws_action":{"action":""},"tg_proxy_info":{},"tg_proxy_action":{"action":""},"steer_info":{},"steer_action":{"action":""},"vpn_state":{"id":""},"vpn_action":{"id":"","action":"","target":""},"vpn_editor":{"id":""},"vpn_nodes":{"id":"","target":""},"vpn_edit":{"id":"","change":""},"vpn_subscription_url":{"id":""},"vpn_list_page":{"job":"","kind":"","page":0,"search":""},"zapret_module_info":{"id":""},"zapret_module_action":{"id":"","action":""},"system_info":{},"system_action":{"action":""},"cleanup_preview":{},"cleanup_apply":{"revision":""},"adblock_draft":{},"adblock_action":{"action":"","change":""},"domain_search":{"domain":""},"doh_info":{},"doh_action":{"action":""},"dns_info":{},"dns_check":{"domain":""},"zapret_presets":{},"zapret_preset_preview":{"name":""},"zapret_preset_write":{"operation":"","name":"","expected":"","selection":""},"zapret_constructor":{"topic":"","profile":"","list":"","page":0,"run":""}}' ;;
    call:instructions_list|call:instructions_read|call:instructions_write) ows_guides "$2" ;;
    call:vpn_state|call:vpn_action|call:vpn_editor|call:vpn_nodes|call:vpn_edit|call:vpn_subscription_url) ows_vpn "$2" ;;
    call:tg_proxy_info|call:tg_proxy_action)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/tg-ws-proxy.sh
        . /usr/lib/ows/registry.sh
        if [ "$(registry_adapter_service tg-ws-proxy)" != tg-ws-proxy ]; then
            echo '{"error":"Адаптер tg-ws-proxy не подключён"}'
        elif [ "$2" = tg_proxy_info ]; then
            tgws_proxy_info
        else
            json_load "$(cat)" || exit 1
            json_get_var action action
            json_init
            if tgws_proxy_action_allowed "$action" && job=$(/usr/sbin/ows tg-ws-proxy "$action"); then
                json_add_string job "$job"
            else
                json_add_string error 'Не удалось поставить операцию прокси в очередь'
            fi
            json_dump
        fi
        ;;
    call:status) ows_status ;;
    call:dns_info)
        . /usr/lib/ows/dns.sh
        . /usr/lib/ows/network-compat.sh
        ows_dns_info
        ;;
    call:doh_info)
        . /usr/lib/ows/doh.sh
        . /usr/lib/ows/doh-live.sh
        doh_info
        ;;
    call:domain_search)
        . /usr/share/libubox/jshn.sh
        json_load "$(cat)" || exit 1
        json_get_var domain domain
        [ "${#domain}" -le 254 ] || { echo '{"error":"Слишком длинное доменное имя"}'; exit 0; }
        command -v jq >/dev/null && command -v timeout >/dev/null ||
            { echo '{"error":"Для поиска нужны jq и timeout"}'; exit 0; }
        timeout -k 2 12 sh /usr/lib/ows/domain-search.sh "$domain" ||
            echo '{"error":"Поиск не завершился. Повторите запрос."}'
        ;;
    call:adblock_draft)
        command -v jq >/dev/null || { echo '{"error":"Для настроек dnsmasq + nftables нужен jq"}'; exit 0; }
        . /usr/lib/ows/adblock-migration.sh
        . /usr/lib/ows/adblock-policy.sh
        . /usr/lib/ows/adblock-live.sh
        . /usr/lib/ows/adblock-update.sh
        owner=zapret-manager
        paused=false fast=false profile= mask=0 settings=null light_start=false light_dns_only=false legacy=false
        if [ -f "$OWS_ADBLOCK_MANAGER" ]; then legacy=true; fi
        if adblock_fast_enabled; then fast=true; fi
        if adblock_owner; then
            owner=ows
            if draft=$(adblock_draft_path) && bank=$(adblock_active_bank "$draft"); then
                if [ -f "$bank/paused" ]; then paused=true; fi
                if selection=$(adblock_live_selection "$draft" "$bank") && adblock_valid_selection "$selection"; then
                    profile=${selection%:*}; mask=${selection##*:}
                fi
                if adblock_dns_only_light "$draft" "$bank"; then light_dns_only=true; fi
                settings=$(adblock_policy_report "$draft" "$bank") || settings=null
            fi
        elif adblock_first_available; then
            light_start=true
        fi
        adblock_draft_report | jq --arg owner "$owner" --arg profile "$profile" --argjson mask "$mask" \
            --argjson paused "$paused" --argjson fast "$fast" --argjson settings "$settings" \
            --argjson light_start "$light_start" --argjson light_dns_only "$light_dns_only" --argjson legacy "$legacy" \
            '.owner=$owner | .active_profile=$profile | .ip_mask=$mask | .paused=$paused | .fast_enabled=$fast | .settings=$settings |
             .light_start=$light_start | .light_dns_only=$light_dns_only | .legacy=$legacy'
        ;;
    call:system_info)
        . /usr/lib/ows/zapret-module.sh
        . /usr/lib/ows/system.sh
        . /usr/lib/ows/system-handover.sh
        . /usr/lib/ows/network-compat.sh
        system_info
        ;;
    call:services_status)
        . /usr/lib/ows/service-status.sh
        ows_services_status
        ;;
    call:cleanup_preview)
        /usr/sbin/ows cleanup preview
        ;;
    call:cleanup_apply)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/rpc-response.sh
        json_load "$(cat)" || exit 1
        json_get_var revision revision
        ows_rpc_enqueue 'Не удалось поставить очистку в очередь. Повторите проверку.' cleanup apply "$revision"
        ;;
    call:adblock_action|call:doh_action|call:system_action)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/rpc-response.sh
        json_load "$(cat)" || exit 1
        json_get_var action action
        if [ "$2:$action" = adblock_action:edit ]; then
            json_get_var change change
            if [ -z "$change" ] || [ "${#change}" -gt 65535 ]; then
                echo '{"error":"Пустой или слишком большой запрос"}'; exit 0
            fi
            umask 077
            request=$(mktemp /tmp/ows-adblock-request.XXXXXX) || exit 1
            trap 'rm -f "$request"' EXIT
            printf '%s\n' "$change" > "$request" || exit 1
            ows_rpc_enqueue 'Не удалось поставить изменение в очередь' adblock edit "$request"
        else
            ows_rpc_enqueue 'Не удалось поставить операцию в очередь' "${2%_action}" "$action"
        fi
        ;;
    call:dns_check)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/rpc-response.sh
        . /usr/lib/ows/dns.sh
        json_load "$(cat)" || exit 1
        json_get_var domain domain
        set --
        if [ -n "$domain" ]; then
            if ! ows_dns_domain_valid "$domain"; then
                echo '{"error":"Введите корректное доменное имя без протокола и пути"}'
                exit 0
            fi
            set -- "$domain"
        fi
        ows_rpc_enqueue 'Не удалось поставить проверку DNS в очередь' dns-check "$@"
        ;;
    call:zapret_presets|call:zapret_preset_preview|call:zapret_preset_write)
        command -v jq >/dev/null || { echo '{"error":"Для пресетов Zapret2 нужен jq"}'; exit; }
        . /usr/lib/ows/zapret-presets.sh
        case "$2" in
            zapret_presets) preset_catalog ;;
            zapret_preset_preview) preset_request preview ;;
            zapret_preset_write)
                request=$(cat)
                operation=$(printf '%s\n' "$request" | jsonfilter -e '@.operation')
                case "$operation" in
                    save|delete|apply|select) printf '%s\n' "$request" | preset_request "$operation" ;;
                    *) echo '{"error":"Неизвестная операция пресета"}' ;;
                esac
                ;;
        esac
        ;;
    call:zapret_module_info|call:zapret_module_action|call:zapret_constructor)
        . /usr/share/libubox/jshn.sh
        json_load "$(cat)" || exit 1
        json_get_vars id action topic profile list page run
        . /usr/lib/ows/zapret-module.sh
        . /usr/lib/ows/zapret-constructor.sh
        RUN=/tmp/ows
        case "$2" in
            zapret_module_info) zapret_module_info "$id" ;;
            zapret_constructor) zapret_constructor_state "$topic" "$profile" "$list" "$page" "$run" ;;
            zapret_module_action)
                json_init
                limit=280
                case "$action" in compare-start:*) limit=8192 ;; esac
                if [ "${#action}" -le "$limit" ] && zapret_module_action_allowed "$id" "$action" &&
                    job=$(/usr/sbin/ows zapret "$id" "$action"); then
                    json_add_string job "$job"
                else
                    json_add_string error 'Не удалось поставить действие Zapret в очередь'
                fi
                json_dump
                ;;
        esac
        ;;
    call:vpn_list_page)
        . /usr/share/libubox/jshn.sh
        json_load "$(cat)" || exit 1
        json_get_vars job kind page search
        case "$job" in ''|*[!0-9-]*) exit 1 ;; esac
        case "$kind" in domains|prefixes|nodes) ;; *) exit 1 ;; esac
        case "$page" in ''|0|0*|*[!0-9]*) exit 1 ;; esac
        [ "$page" -le 100000 ] && [ "${#search}" -le 128 ] || exit 1
        dir=/tmp/ows/jobs/$job
        if [ ! -f "$dir/preview-$kind" ] ||
            [ "$(jsonfilter -i "$dir/status.json" -e '@.phase' 2>/dev/null)" != done ]; then
            echo '{"error":"Предпросмотр недоступен. Откройте список заново."}'
        elif [ "$kind" = nodes ]; then
            awk -v page="$page" 'NR>(page-1)*80 && NR<=page*80 {print} NR>=page*80 {exit}' \
                "$dir/preview-nodes" | jq -cs '{entries:.}'
        else
            OWS_PREVIEW_SEARCH=$search LC_ALL=C awk -v page="$page" '
                BEGIN {term=tolower(ENVIRON["OWS_PREVIEW_SEARCH"])}
                term=="" || index(tolower($0),term) {
                    found++; if (found>(page-1)*80 && found<=page*80) print substr($0,1,512)
                }
                END {print found+0}
            ' "$dir/preview-$kind" | jq -Rsc 'split("\n")[:-1] | {entries:.[:-1],total:(.[-1]|tonumber)}'
        fi
        ;;
    call:job_status|call:job_output)
        . /usr/share/libubox/jshn.sh
        json_load "$(cat)" || exit 1
        json_get_var job job
        [ -n "$job" ] || exit 1
        if [ "$2" = job_status ]; then
            ows_status "$job"
        else
            output=$(/usr/sbin/ows output "$job") || exit 1
            json_init
            json_add_string output "$output"
            result=/tmp/ows/jobs/$job/result.json
            if [ -r "$result" ]; then
                case "$(jsonfilter -i "$result" -e '@.kind' 2>/dev/null)" in
                    node_batch|list_preview|draft_preview)
                        jq -c --arg output "$output" '{output:$output,result:.}' "$result"
                        exit $?
                        ;;
                esac
                ok=$(jsonfilter -i "$result" -e '@.ok' 2>/dev/null)
                if [ "$ok" = true ] || [ "$ok" = false ]; then
                    json_add_object probe
                    if [ "$ok" = true ]; then json_add_boolean ok 1; else json_add_boolean ok 0; fi
                    for metric in handshake_ms ttfb_ms; do
                        value=$(jsonfilter -i "$result" -e "@.$metric" 2>/dev/null)
                        case "$value" in ''|*[!0-9]*) ;; *) json_add_int "$metric" "$value" ;; esac
                    done
                    json_close_object
                fi
            fi
            json_dump
        fi
        ;;
    call:catalog|call:preview|call:apply_action)
        . /usr/lib/ows/zapret2-editor.sh
        editor_request "$2"
        ;;
    call:module_list|call:module_status|call:module_preview|call:module_attach|call:module_link)
        . /usr/lib/ows/registry.sh
        registry_request "$2"
        ;;
    call:stgws_info|call:stgws_action)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/stgws.sh
        entry=/etc/ows/adapters/stgws.json
        if [ "$(jsonfilter -i "$entry" -e '@.kind' 2>/dev/null)" != adapter ] ||
            [ "$(jsonfilter -i "$entry" -e '@.service' 2>/dev/null)" != tgws ]; then
            echo '{"error":"Адаптер sTGWS не подключён"}'
        elif [ "$2" = stgws_info ]; then
            stgws_info
        else
            json_load "$(cat)" || exit 1
            json_get_var action action
            json_init
            if stgws_action_allowed "$action" && job=$(/usr/sbin/ows stgws "$action"); then
                json_add_string job "$job"
            else
                json_add_string error 'Не удалось поставить операцию sTGWS в очередь'
            fi
            json_dump
        fi
        ;;
    call:steer_info|call:steer_action)
        . /usr/share/libubox/jshn.sh
        . /usr/lib/ows/steer.sh
        entry=/etc/ows/adapters/steer.json
        if [ "$(jsonfilter -i "$entry" -e '@.kind' 2>/dev/null)" != adapter ] ||
            [ "$(jsonfilter -i "$entry" -e '@.service' 2>/dev/null)" != steer ]; then
            echo '{"error":"Адаптер steer не подключён"}'
        elif [ "$2" = steer_info ]; then
            steer_info
        else
            json_load "$(cat)" || exit 1
            json_get_var action action
            json_init
            if steer_action_allowed "$action" && job=$(/usr/sbin/ows steer "$action"); then
                json_add_string job "$job"
            else
                json_add_string error 'Не удалось поставить проверку steer в очередь'
            fi
            json_dump
        fi
        ;;
    *) exit 1 ;;
esac
