#!/bin/sh
set -eu
umask 077

LIB=/usr/lib/ows
RUN=/tmp/ows
STATE=/etc/ows
QUEUE=$RUN/queue
JOBS=$RUN/jobs
PENDING=$STATE/pending

fail() { printf '%s\n' "$*" >&2; exit 1; }
prepare() { mkdir -p "$QUEUE" "$JOBS" "$STATE"; }

publish() {
    local now
    now=$(date +%s) || return 1
    if [ "$2" = waiting ]; then
        printf '{"job":"%s","phase":"waiting","wait_reason":"%s","updated":%s}\n' "$1" "$3" "$now" > "$JOBS/$1/status.new" || return 1
    else
        printf '{"job":"%s","phase":"%s","updated":%s}\n' "$1" "$2" "$now" > "$JOBS/$1/status.new" || return 1
    fi
    mv "$JOBS/$1/status.new" "$JOBS/$1/status.json" &&
        printf '%s %s%s\n' "$now" "$2" "${3:+ $3}" >> "$JOBS/$1/events" &&
        cp "$JOBS/$1/status.json" "$RUN/latest.$1.new" &&
        mv "$RUN/latest.$1.new" "$RUN/latest.json"
}

critical() {
    printf '%s %s %s\n' "$(date +%s)" "$1" "$2" >> "$STATE/critical.log"
    tail -n 100 "$STATE/critical.log" > "$STATE/critical.new"
    mv "$STATE/critical.new" "$STATE/critical.log"
}

enqueue() (
    kind=$1
    shift
    case "$kind" in
        zapret2)
            [ "$#" -ge 1 ] && [ "$#" -le 2 ] && [ -f "$1" ] || fail 'Usage: ows apply FILE'
            revision=${2:-}
            if [ -n "$revision" ]; then
                case "$revision" in *[!a-f0-9]*) fail 'Invalid revision' ;; esac
                [ "${#revision}" = 64 ] || fail 'Invalid revision'
            fi
            ;;
        stgws)
            . "$LIB/stgws.sh"
            [ "$#" = 1 ] && stgws_action_allowed "$1" || fail 'Unknown sTGWS action'
            ;;
        tg-ws-proxy)
            . "$LIB/tg-ws-proxy.sh"
            [ "$#" = 1 ] && tgws_proxy_action_allowed "$1" || fail 'Unknown Telegram proxy action'
            ;;
        adblock)
            if [ "${1:-}" = edit ]; then
                [ "$#" = 2 ] && [ -f "$2" ] || fail 'Usage: ows adblock edit FILE'
                payload=$2
                set -- edit
            fi
            [ "$#" = 1 ] || fail 'Usage: ows adblock ACTION'
            case "$1" in
                prepare|check|refresh|schedule-plan|takeover|refresh-auto|refresh-live|schedule:on|schedule:off|pause|resume|edit|compact|expand|enable-light|install-fast) ;;
                configure:*) . "$LIB/adblock-update.sh"; adblock_valid_selection "${1#configure:}" || fail 'Invalid adblock selection' ;;
                *) fail 'Unknown adblock action' ;;
            esac
            ;;
        dns)
            [ "$#" = 1 ] || fail 'Unknown DNS action'
            case "$1" in
                check) ;;
                check:*)
                    . "$LIB/dns.sh"
                    ows_dns_domain_valid "${1#*:}" || fail 'Invalid DNS domain'
                    ;;
                *) fail 'Unknown DNS action' ;;
            esac
            ;;
        doh)
            [ "$#" = 1 ] || fail 'Usage: ows doh install|check|prepare|verify|takeover|test-switch|watch|configure:CURRENT:NEW'
            case "$1" in
                install|check|prepare|verify|takeover|test-switch|watch) ;;
                configure:*) . "$LIB/doh-live.sh"; doh_configure_valid "${1#configure:}" || fail 'Invalid DoH chain' ;;
                *) fail 'Unknown DoH action' ;;
            esac
            ;;
        system)
            . "$LIB/system.sh"
            [ "$#" = 1 ] && system_action_valid "$1" || fail 'Unknown system action'
            ;;
        cleanup)
            . "$LIB/legacy-cleanup.sh"
            [ "$#" = 1 ] && legacy_cleanup_action_valid "$1" || fail 'Invalid cleanup revision'
            ;;
        zapret-module)
            . "$LIB/zapret-module.sh"
            . "$LIB/zapret-constructor.sh"
            [ "$#" = 2 ] && zapret_module_action_allowed "$1" "$2" || fail 'Unknown Zapret action'
            set -- "$1:$2"
            ;;
        *)
            . "$LIB/vpn.sh"
            ows_vpn_load "$kind" "$LIB" || fail 'Unknown VPN driver'
            "${kind}_action_allowed" "${1:-}" || fail 'Unknown VPN action'
            if [ "$1" = edit ]; then
                [ "$#" = 2 ] && [ -f "$2" ] || fail 'Missing VPN edit'
                payload=$2
            else
                [ "$#" = 1 ] || fail 'Unexpected VPN argument'
            fi
            ;;
    esac
    prepare
    exec 8>"$RUN/submit.lock"
    flock -x 8
    if [ "$kind" = doh ] && [ "$1" = watch ]; then
        for ticket in "$QUEUE"/*; do
            [ -f "$ticket" ] || continue
            id=${ticket##*/}
            if [ "$(cat "$JOBS/$id/kind" 2>/dev/null)" = doh ] && [ "$(cat "$JOBS/$id/action" 2>/dev/null)" = watch ]; then
                printf '%s\n' "$id"
                exit 0
            fi
        done
    fi
    set -- "$1" "$(date +%s)"
    count=0
    for ticket in "$QUEUE"/*; do
        [ -f "$ticket" ] || break
        count=$((count + 1))
    done
    [ "$count" -lt 16 ] || fail 'Queue is full'
    serial=$(cat "$RUN/serial" 2>/dev/null || echo 0)
    serial=$((serial + 1))
    printf '%s\n' "$serial" > "$RUN/serial"
    id=$(printf '%012d-%s' "$serial" "$2")
    mkdir "$JOBS/$id"
    printf '%s\n' "$kind" > "$JOBS/$id/kind"
    if [ "$kind" = zapret2 ]; then
        # Bound the queued input even if the supplied file grows during the read.
        dd if="$1" of="$JOBS/$id/candidate" bs=1024 count=257 2>/dev/null
        if [ "$(wc -c < "$JOBS/$id/candidate")" -gt 262144 ]; then
            rm -f "$JOBS/$id/candidate"
            fail 'Config exceeds 256 KiB'
        fi
        printf '%s\n' "$revision" > "$JOBS/$id/revision"
    else
        printf '%s\n' "$1" > "$JOBS/$id/action"
        if [ -n "${payload:-}" ]; then
            dd if="$payload" of="$JOBS/$id/payload" bs=1024 count=65 2>/dev/null
            [ "$(wc -c < "$JOBS/$id/payload")" -le 65536 ] || {
                rm -f "$JOBS/$id/payload"
                fail 'Draft edit exceeds 64 KiB'
            }
        fi
    fi
    printf '{"job":"%s","phase":"queued","updated":%s}\n' "$id" "$2" > "$JOBS/$id/status.json"
    printf '%s queued\n' "$2" > "$JOBS/$id/events"
    : > "$QUEUE/$id"
    printf '%s\n' "$id"
)

recover() {
    [ -d "$PENDING" ] || return 0
    id=$(cat "$PENDING/job")
    if [ -f "$PENDING/committed" ]; then
        if [ -d "$JOBS/$id" ]; then publish "$id" applied || return 1; fi
        rm -rf "$PENDING"
        return 0
    fi
    if restore_config "$PENDING"; then
        if [ -d "$JOBS/$id" ]; then publish "$id" rolled_back || return 1; fi
        rm -rf "$PENDING"
    else
        critical "$id" rollback_failed
        if [ -d "$JOBS/$id" ]; then publish "$id" rollback_failed; fi
        return 1
    fi
}

lock_zapret2() {
    exec 5>/var/lock/zapret2-health.lock
    exec 4>/var/lock/zapret2-strategy-check.lock
    flock -n 5 && flock -n 4
}

process() (
    id=$1
    job=$JOBS/$id
    if ! lock_zapret2; then
        publish "$id" config_busy
        return
    fi
    publish "$id" validating || return 1
    if ! config_current "$job"; then
        publish "$id" config_changed
        return
    fi
    if ! validate_config "$job" > "$job/output" 2>&1; then
        publish "$id" invalid_config
        return
    fi
    if ! save_snapshot "$job" "$id" "$PENDING"; then
        if config_current "$job"; then publish "$id" snapshot_failed; else publish "$id" config_changed; fi
        return
    fi
    publish "$id" applying || return 1
    if apply_config "$PENDING"; then
        : > "$PENDING/committed" || return 1
        recover
        return
    fi
    publish "$id" rolling_back || return 1
    recover
)

process_module() {
    local id=$1 kind=$2 result outcome action
    publish "$id" applying || return 1
    result=done
    outcome=0
    action=$(cat "$JOBS/$id/action") || return 1
    (
        (
            export OWS_JOB_RESULT="$JOBS/$id/result.json"
            case "$kind" in
                stgws) stgws_execute "$action" ;;
                cleanup)
                    . "$LIB/legacy-cleanup.sh"
                    legacy_cleanup_apply "$action"
                    ;;
                tg-ws-proxy)
                    . "$LIB/tg-ws-proxy.sh"
                    tgws_proxy_execute "$action"
                    ;;
                dns)
                    . "$LIB/dns.sh"
                    if [ "$action" = check ]; then ows_dns_check; else ows_dns_check_domain "${action#*:}"; fi
                    ;;
                doh)
                    . "$LIB/doh.sh"
                    . "$LIB/doh-live.sh"
                    case "$action" in
                        install) . "$LIB/packages.sh"; ows_install_repo_packages https-dns-proxy luci-app-https-dns-proxy ;;
                        check) doh_check ;;
                        prepare) ! doh_owned && doh_prepare ;;
                        verify) ! doh_owned && doh_verify ;;
                        takeover) doh_takeover ;;
                        configure:*) doh_configure "${action#configure:}" ;;
                        watch) doh_watch ;;
                        test-switch) doh_test_switch ;;
                        *) exit 1 ;;
                    esac
                    ;;
                system)
                    . "$LIB/zapret-module.sh"
                    . "$LIB/system.sh"
                    . "$LIB/system-handover.sh"
                    . "$LIB/network-compat.sh"
                    . "$LIB/network-handover.sh"
                    case "$action" in net:takeover) . "$LIB/doh.sh"; . "$LIB/doh-live.sh" ;; esac
                    system_execute "$action"
                    ;;
                adblock)
                    . "$LIB/adblock-migration.sh"
                    . "$LIB/adblock-policy.sh"
                    . "$LIB/adblock-update.sh"
                    . "$LIB/adblock-live.sh"
                    case "$action" in
                        prepare) ! adblock_owner && adblock_prepare_draft ;;
                        check) if adblock_owner; then adblock_live_check; else adblock_check_draft; fi ;;
                        refresh) ! adblock_owner && adblock_build_candidate ;;
                        schedule-plan) ! adblock_owner && adblock_schedule_plan ;;
                        takeover) adblock_apply_live takeover ;;
                        compact) . "$LIB/adblock-storage.sh"; adblock_storage_compact ;;
                        expand) . "$LIB/adblock-storage.sh"; adblock_storage_expand ;;
                        enable-light) adblock_enable_light ;;
                        install-fast) . "$LIB/packages.sh"; adblock_install_fast ;;
                        refresh-auto|refresh-live|schedule:*|pause|resume|configure:*|edit)
                            adblock_live_command "$action" "$JOBS/$id/payload"
                            ;;
                        *) exit 1 ;;
                    esac
                    ;;
                zapret-module)
                    . "$LIB/zapret-module.sh"
                    . "$LIB/zapret-constructor.sh"
                    zapret_module_execute "$action"
                    ;;
                *)
                    . "$LIB/vpn.sh"
                    ows_vpn_load "$kind" "$LIB" || exit 1
                    "${kind}_execute" "$action" "$JOBS/$id/payload"
                    ;;
            esac
        ) 3>&- 6>&- 7>&- 8>&- || outcome=$?
        printf '%s\n' "$outcome" > "$JOBS/$id/exit"
    ) 2>&1 9>&- | tail -c 8192 > "$JOBS/$id/output" || return 1
    outcome=$(cat "$JOBS/$id/exit") || return 1
    case "$outcome" in
        0) ;;
        3) result=rollback_failed; critical "$id" rollback_failed ;;
        *) result=operation_failed ;;
    esac
    publish "$id" "$result" || return 1
    [ "$outcome" != 3 ]
}

diagnostic_job() {
    case "$1" in dns|doh|netshift|tg-ws-proxy) ;; *) return 1 ;; esac
    case "$1:$(cat "$JOBS/$2/action" 2>/dev/null)" in
        dns:check|dns:check:*|doh:check|netshift:diag|tg-ws-proxy:check) return 0 ;;
        *) return 1 ;;
    esac
}

process_diagnostic() (
    local id=$1 kind=$2 status action result
    exec 6>"$RUN/diagnostic.lock"
    flock -n 6 || exit 0
    [ -f "$QUEUE/$id" ] || exit 0
    status=$(cat "$JOBS/$id/status.json" 2>/dev/null || :)
    case "$status" in
        *'"phase":"queued"'*|*'"phase":"waiting"'*)
            action=$(cat "$JOBS/$id/action") || exit 1
            if guard_queued_job "$id" "$status" "$kind" "$action"; then
                process_module "$id" "$kind" || exit 1
            else
                result=$?
                [ "$result" = 75 ] && exit 0
                exit "$result"
            fi
            ;;
        *'"phase":"done"'*|*'"phase":"operation_failed"'*|*'"phase":"interrupted"'*) ;;
        *) publish "$id" interrupted || exit 1 ;;
    esac
    rm -f "$QUEUE/$id"
)

diagnostic_worker() {
    local ticket id kind
    prepare
    . "$LIB/queue-locks.sh"
    exec 9>"$RUN/diagnostic-worker.lock"
    flock -n 9 || fail 'Diagnostic worker already running'
    while :; do
        for ticket in "$QUEUE"/*; do
            [ -f "$ticket" ] || continue
            id=${ticket##*/}
            kind=$(cat "$JOBS/$id/kind" 2>/dev/null || :)
            if diagnostic_job "$kind" "$id"; then
                process_diagnostic "$id" "$kind" 9>&- || return 1
            fi
        done
        sleep 3
    done
}

process_writer() (
    local id=$1 kind=$2 action=$3 status
    status=$(cat "$JOBS/$id/status.json" 2>/dev/null || :)
    case "$status" in
        *'"phase":"queued"'*|*'"phase":"waiting"'*)
            guard_queued_job "$id" "$status" "$kind" "$action" || exit $?
            case "$kind" in
                zapret2|'') process "$id" 3>&- 7>&- 8>&- || exit 1 ;;
                *) process_module "$id" "$kind" || exit 1 ;;
            esac
            ;;
        *'"phase":"applied"'*|*'"phase":"rolled_back"'*|*'"phase":"invalid_config"'*|*'"phase":"snapshot_failed"'*|*'"phase":"config_changed"'*|*'"phase":"config_busy"'*|*'"phase":"done"'*|*'"phase":"operation_failed"'*|*'"phase":"rollback_failed"'*|*'"phase":"interrupted"'*) ;;
        *) publish "$id" interrupted || exit 1 ;;
    esac
    rm -f "$QUEUE/$id" "$JOBS/$id/candidate" "$JOBS/$id/payload"
)

writer_pass() {
    local pass=$1 ticket id kind action result
    for ticket in "$QUEUE"/*; do
        [ -f "$ticket" ] || continue
        id=${ticket##*/}
        kind=$(cat "$JOBS/$id/kind" 2>/dev/null || :)
        if diagnostic_job "$kind" "$id"; then
            if [ "$pass" = once ]; then process_diagnostic "$id" "$kind" 9>&- || return 1; fi
            continue
        fi
        action=$(cat "$JOBS/$id/action" 2>/dev/null || :)
        if priority_job "$kind" "$action"; then
            [ "$pass" = priority ] || continue
        elif [ "$pass" = priority ]; then
            continue
        fi
        if process_writer "$id" "$kind" "$action"; then
            if [ "$pass" != priority ]; then writer_pass priority || return 1; fi
            continue
        else
            result=$?
        fi
        if [ "$result" = 75 ]; then
            [ "$pass" = priority ] && continue
            break
        fi
        return 1
    done
    return 0
}

recover_worker() {
    if [ -d "$PENDING" ]; then (lock_zapret2 && recover) || return 1; fi
    if [ -r "$LIB/system.sh" ]; then
        . "$LIB/zapret-module.sh"
        . "$LIB/system.sh"
        . "$LIB/system-handover.sh"
        . "$LIB/network-compat.sh"
        . "$LIB/network-handover.sh"
        network_handover_recover || fail 'Pending network handover needs recovery'
        system_handover_recover || fail 'Pending system handover needs recovery'
        system_recover || fail 'Pending system transaction needs recovery'
    fi
    if [ -r "$LIB/doh-live.sh" ]; then
        . "$LIB/doh.sh"
        . "$LIB/doh-live.sh"
        doh_takeover_recover && doh_recover_switch || fail 'Pending DoH transaction needs recovery'
    fi
    if [ -r "$LIB/adblock-live.sh" ]; then
        . "$LIB/adblock-migration.sh"
        . "$LIB/adblock-policy.sh"
        . "$LIB/adblock-live.sh"
        adblock_live_recover || fail 'Pending adblock transaction needs recovery'
    fi
    if [ -r "$LIB/vpn.sh" ]; then
        ( . "$LIB/vpn.sh"; ows_vpn_recover "$LIB" ) || fail 'Pending VPN transaction needs recovery'
    fi
}

worker() {
    prepare
    exec 9>"$RUN/worker.lock"
    flock -n 9 || fail 'Worker already running'
    . "$LIB/queue-locks.sh"
    . "$LIB/zapret2.sh"
    if [ -r "$LIB/stgws.sh" ]; then . "$LIB/stgws.sh"; fi
    for dep in uci cmp pgrep; do command -v "$dep" >/dev/null || fail "Missing dependency: $dep"; done
    (
        lock_job_resources -x dns firewall telegram || exit 1
        recover_worker 3>&- 7>&- 8>&-
    ) || return 1
    # Keep the background maintenance functions loaded in the worker.
    if [ -r "$LIB/adblock-live.sh" ]; then
        . "$LIB/adblock-migration.sh"
        . "$LIB/adblock-policy.sh"
        . "$LIB/adblock-live.sh"
    fi
    if [ -r "$LIB/network-compat.sh" ]; then
        . "$LIB/system.sh"
        . "$LIB/network-compat.sh"
    fi
    local cutoff remaining pass=normal
    if [ "${1:-}" = --once ]; then pass=once; fi
    while :; do
        writer_pass priority && writer_pass "$pass" || return 1
        [ "${1:-}" != --once ] || return 0
        if [ -r "$LIB/stgws.sh" ] && [ "$(date +%s)" -ge "${next_stgws_tick:-0}" ]; then
            stgws_tick || :
            next_stgws_tick=$(($(date +%s) + 60))
        fi
        if command -v adblock_live_ensure >/dev/null && [ "$(date +%s)" -ge "${next_adblock_tick:-0}" ] &&
            run_maintenance adblock_live_ensure; then
            next_adblock_tick=$(($(date +%s) + 60))
        fi
        if command -v network_tick >/dev/null && [ "$(date +%s)" -ge "${next_network_tick:-0}" ] &&
            run_maintenance network_tick >/dev/null 2>&1; then
            next_network_tick=$(($(date +%s) + 60))
        fi
        if [ "$(date +%s)" -ge "${next_cleanup:-0}" ]; then
            cutoff=$(($(date +%s) - 86400))
            remaining=0
            for path in $(printf '%s\n' "$JOBS"/* | sort -r); do
                [ -d "$path" ] || break
                [ -f "$QUEUE/${path##*/}" ] && continue
                timestamp=${path##*-}
                case "$timestamp" in ''|*[!0-9]*) continue ;; esac
                remaining=$((remaining + 1))
                [ "$timestamp" -ge "$cutoff" ] && [ "$remaining" -le 100 ] || rm -rf "$path"
            done
            next_cleanup=$(($(date +%s) + 300))
        fi
        sleep 2
    done
}

case "${1:-}" in
    apply) shift; enqueue zapret2 "$@" ;;
    zapret) shift; enqueue zapret-module "$@" ;;
    stgws) shift; enqueue stgws "$@" ;;
    tg-ws-proxy) shift; enqueue tg-ws-proxy "$@" ;;
    adblock) shift; enqueue adblock "$@" ;;
    doh) shift; enqueue doh "$@" ;;
    cleanup)
        case "$#:${2:-}" in
            2:preview) . "$LIB/legacy-cleanup.sh"; legacy_cleanup_preview ;;
            3:apply) enqueue cleanup "apply:$3" ;;
            *) fail 'Usage: ows cleanup preview | ows cleanup apply REVISION' ;;
        esac
        ;;
    system)
        shift
        . "$LIB/system.sh"
        . "$LIB/system-handover.sh"
        [ "$#" = 1 ] && system_action_valid "$1" || fail 'Unknown system action'
        case "$1" in
            takeover) enqueue system "$1" ;;
            ipv6:zapret2:*) system_require_control && system_ipv6_zapret2_queue "${1##*:}" ;;
            *) system_require_control && enqueue system "$1" ;;
        esac
        ;;
    dns-check)
        shift
        case "$#" in
            0) enqueue dns check ;;
            1) enqueue dns "check:$1" ;;
            *) fail 'Usage: ows dns-check [DOMAIN]' ;;
        esac
        ;;
    worker)
        shift
        if [ "${1:-}" = --diagnostic ]; then diagnostic_worker; else worker "$@"; fi
        ;;
    status|log|output)
        if [ "${1:-}" = status ] && [ "$#" = 1 ]; then
            if [ -r "$RUN/latest.json" ]; then cat "$RUN/latest.json"; else echo '{"phase":"idle"}'; fi
        else
            case "${2:-}" in ''|*[!0-9-]*) fail 'Invalid job ID' ;; esac
            case "$1" in
                log) cat "$JOBS/$2/events" ;;
                output) [ ! -f "$JOBS/$2/output" ] || tail -c 8192 "$JOBS/$2/output" ;;
                *) cat "$JOBS/$2/status.json" ;;
            esac
        fi
        ;;
    *)
        kind=${1:-}
        if [ -n "$kind" ] && [ -r "$LIB/vpn.sh" ]; then
            . "$LIB/vpn.sh"
            if ows_vpn_service "$kind" >/dev/null; then
                shift
                enqueue "$kind" "$@"
                exit
            fi
        fi
        fail 'Usage: ows apply FILE | MODULE ACTION | status [JOB] | log JOB | output JOB'
        ;;
esac
